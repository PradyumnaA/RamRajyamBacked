# Example environment variables for Ram-rajyam-backend
# Copy this file to `.env` and fill in real values. Do NOT commit secrets.

# Server
PORT=3004

# MongoDB (the code uses MONGODB_URL in `index.js`)
MONGODB_URL=mongodb+srv://<user>:<password>@cluster0.example.mongodb.net/<dbname>?retryWrites=true&w=majority

# Optional legacy DB fields (some devs use these in local scripts)
DB_HOST=localhost
DB_USER=my_db_user
DB_PASSWORD=my_db_password
DB_NAME=my_db_name

# JWT / Auth
# The project currently reads `secretKey` from `config.js` (auto-generated),
# but some deployments include a stable JWT secret here for reproducible tokens.
JWT_SECRET=replace_with_a_secure_random_hex

# DigitalOcean Spaces (used by `s3.js` and many controllers)
# DO_SPACES_ENDPOINT should be the host portion (e.g. "blr1.digitaloceanspaces.com")
DO_SPACES_ENDPOINT=blr1.digitaloceanspaces.com
DO_SPACES_KEY=your_spaces_access_key
DO_SPACES_SECRET=your_spaces_secret
DO_SPACES_BUCKET=your-space-bucket-name
# Public base URL used across controllers to build image URLs (e.g. https://<bucket>.<endpoint>)
DO_SPACES_URL=https://your-space-bucket-name.blr1.digitaloceanspaces.com

# S3 / AWS compatible credentials (s3.js supports AWS-style creds)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=blr1

# Uploads bucket name (used in many controllers as UPLOADSIMAGEBUCKET)
UPLOADSIMAGEBUCKET=your-uploads-bucket

# Email (nodemailer) - used in `utiles/email.js`
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=no-reply@example.com
EMAIL_PASS=your_email_password

# Twilio (dependency present in package.json — add if you use SMS features)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Any other provider keys referenced in controllers (example placeholders)
# STRIPE_API_KEY=your_stripe_key
# SENDGRID_API_KEY=your_sendgrid_key

# Notes:
# - `index.js` expects `MONGODB_URL` and will log `MONGODB_URL present?:` at startup.
# - `s3.js` will exit if `DO_SPACES_ENDPOINT` is missing.
# - Avoid committing `.env` to source control. Use CI/CD secret storage for production.
